{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Retrieval",
  "type": "object",
  "required": ["guideline_texts", "cases", "gaps_in_corpus"],
  "additionalProperties": false,
  "properties": {
    "guideline_texts": {"type": "array", "items": {"type": "string"}},
    "cases": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["case_no", "path", "guidelines", "outcome", "relevance_note"],
        "additionalProperties": false,
        "properties": {
          "case_no": {"type": "string"},
          "path": {"type": "string", "pattern": "^corpus/doha/cases/"},
          "guidelines": {"type": "array", "items": {"enum": ["A","B","C","D","E","F","G","H","I","J","K","L","M"]}},
          "outcome": {"enum": ["granted", "denied", "remanded"]},
          "relevance_note": {"type": "string"}
        }
      }
    },
    "gaps_in_corpus": {"type": "array", "items": {"type": "string"}}
  }
}
