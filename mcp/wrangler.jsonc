{
  // Cloudflare Worker for the Adverse Information Assistant's hosted MCP
  // reference server (design: docs/HOSTED-MCP-DESIGN.md). Stateless: it serves
  // reference material by categorical key and never receives a narrative.
  // Local dev:   npm run mcp:worker:dev      (needs mcp/release/, built by scripts/hosted_release.py)
  // Production:  npm run mcp:worker:deploy   (owner's machine only; see DEPLOYMENT.md Mode 1b)
  "name": "adverse-information-assistant",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  // The route is the only address. No workers.dev subdomain, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "fsotools.ai/adverse/mcp*", "zone_name": "fsotools.ai" }],
  // The hash-checked release built by scripts/hosted_release.py, read through
  // env.ASSETS only. run_worker_first keeps every file behind the Worker: no
  // asset is ever served as a bare URL.
  "assets": {
    "directory": "./release",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  // Read-only bindings to the Adjudication Atlas's three D1 FTS5 shards of
  // published DOHA decision text (built by doha-decision-search). Only SELECT
  // statements exist in mcp/d1.js; the Worker owns no writable binding.
  // Rebound by hosted_release.py --doha-shards after a shard rebuild.
  "d1_databases": [
    { "binding": "S1", "database_name": "doha-text-doha-new-20261103-s1", "database_id": "2ef4ec15-40a3-47af-8042-ec06c2bb47ff", "remote": true },
    { "binding": "S2", "database_name": "doha-text-doha-new-20261103-s2", "database_id": "c5201500-026f-4cad-93f2-b24ea5dc466f", "remote": true },
    { "binding": "S3", "database_name": "doha-text-doha-new-20261103-s3", "database_id": "84d82b58-0cc4-4378-8128-4593a9f52446", "remote": true }
  ],
  // One shared limit, keyed on the connecting IP (owner decision D6).
  "ratelimits": [{ "name": "MCP_LIMIT", "namespace_id": "4203", "simple": { "limit": 60, "period": 60 } }],
  // The release ids live in release/manifest.json. scripts/hosted_release.py
  // --deploy also passes them as deploy-time vars (--var RELEASE_ID:…,
  // CORPUS_VERSION:…, REPO_COMMIT:…) so get_release can report a deployment
  // whose vars and manifest disagree. This file is never rewritten for them.
  // No request logs: a categorical query still describes the shape of someone's matter.
  "observability": { "enabled": false }
}
